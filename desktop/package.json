{
  "name": "registo-militantes",
  "productName": "Registo de Militantes",
  "version": "1.1.0",
  "description": "Registo e gestão de militantes, quotas, recibos e cartões — dados cifrados no computador",
  "author": "Registo de Militantes",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copiar": "node copiar-web.js",
    "iniciar": "npm run copiar && electron .",
    "dist": "npm run copiar && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pt.registomilitantes.desktop",
    "productName": "Registo de Militantes",
    "copyright": "Registo de Militantes",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "partilha.js", "package.json", "web/**/*", "build/icon.png"],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Registo de Militantes",
      "installerLanguages": ["pt_PT"],
      "language": "2070",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Registo-de-Militantes-${version}-instalador.exe"
    },
    "portable": {
      "artifactName": "Registo-de-Militantes-${version}-portatil.exe"
    }
  }
}
